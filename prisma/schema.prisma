// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model BulkImportJob {
  id              String    @id @default(cuid())
  shop            String
  // Human-friendly per-shop job number, SHARED with BulkExportJob (one sequence
  // across imports + exports) so the combined activity list never repeats a #.
  // Assigned at creation; nullable for rows created before this field existed.
  number          Int?
  // Comma-list of the entities detected across the file's sheets (display only).
  entity          String
  format          String
  status          String    @default("pending")
  // pending | running | complete | failed | cancelled
  // Set by the Cancel button; the worker checks it between sheets and stops.
  cancelRequested Boolean   @default(false)
  // Original uploaded filename (for display + results naming).
  filename        String?
  // R2 key of the staged upload the worker downloads to do the import.
  sourceR2Key     String?
  // The per-sheet plan JSON ([{entity,include,filters,columns}]) and import
  // options JSON ({mode}) this job ran with, so "Repeat" reuses the same config.
  plan            String?
  options         String?
  // Live progress for the determinate bar: records written vs. total importable.
  progressCurrent Int?
  progressTotal   Int?
  // Outcome counts, summed across sheets.
  created         Int       @default(0)
  updated         Int       @default(0)
  deleted         Int       @default(0)
  failed          Int       @default(0)
  // Results workbook (per-row status) uploaded to R2 on completion.
  resultR2Key     String?
  resultUrl       String?
  resultUrlExpiry DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([shop])
}

model BulkExportJob {
  id              String    @id @default(cuid())
  shop            String
  // Human-friendly per-shop job number, SHARED with BulkImportJob (one sequence
  // across imports + exports). Assigned at creation; nullable for legacy rows.
  number          Int?
  // For multi-entity jobs `entity` is a comma-list (e.g. "products,orders")
  // used for display only; the structured spec lives in `spec`.
  entity          String
  format          String
  status          String    @default("pending")
  // pending | running | complete | failed | cancelled
  // Set by the Cancel button; the worker checks it between entities and stops.
  cancelRequested Boolean   @default(false)
  bulkOperationId String?
  // Legacy single-entity column selection; multi-entity jobs use `spec`.
  fields          String?
  // JSON-serialised array of { entity, filters, fields } — the source of
  // truth for multi-entity jobs. Null for legacy single-entity records.
  spec            String?
  // Optional user-chosen filename (without extension).
  filename        String?
  r2Key           String?
  signedUrl       String?
  signedUrlExpiry DateTime?
  rowCount        Int?
  // Live progress for the determinate progress bar. progressCurrent =
  // records processed so far; progressTotal = expected total (null when the
  // entity has no cheap count, which the UI renders as an indeterminate bar).
  progressCurrent Int?
  progressTotal   Int?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([shop])
  @@index([bulkOperationId])
}

model AppSettings {
  shop          String   @id
  // Days after which a job's downloadable files are deleted from R2 (the job
  // row + its history/number are kept). 0 = never delete.
  retentionDays Int      @default(7)
  // Defaults pre-selected on the Export/Import pages.
  defaultExportFormat String @default("excel") // excel | csv | xml | json
  defaultImportMode   String @default("normal") // normal | updateOnly | createOnly | noDelete | dryRun
  // IANA time zone used to DISPLAY job/schedule timestamps (cadence math stays UTC).
  timezone      String   @default("UTC")
  // Email notifications for finished jobs (delivery wired separately).
  notifyEmail     String?
  notifyOnSuccess Boolean @default(false)
  notifyOnError   Boolean @default(false)
  // Security: allow a job's files to be downloaded by external services via
  // their signed link (vs. in-app download only).
  allowExternalDownloads Boolean @default(true)
  // Sheet Permissions: JSON array of entity keys that are BLOCKED from export/
  // import (empty/null = everything allowed).
  blockedEntities String?
  updatedAt     DateTime @updatedAt
}

// A recurring export or import. When due, the scheduler creates a normal job
// (BulkExportJob / BulkImportJob) so the run shows up in Recent activity.
model Schedule {
  id          String    @id @default(cuid())
  shop        String
  type        String    // "export" | "import"
  name        String?
  enabled     Boolean   @default(true)
  // Cadence (evaluated in UTC).
  frequency   String    // "hourly" | "daily" | "weekly" | "monthly"
  hour        Int       @default(3)   // 0-23
  minute      Int       @default(0)   // 0-59
  weekday     Int?      // 0=Sun..6=Sat (weekly)
  monthday    Int?      // 1-31 (monthly)
  // Inline "Schedule on / Repeat every" (Matrixify-style): a deferred first
  // run, an interval cadence that overrides `frequency`, and a run limit.
  startAt       DateTime?
  intervalCount Int?
  intervalUnit  String?   // minutes | hours | days | weeks | months
  remainingRuns Int?      // null = until cancelled; reaching 0 disables
  // What to run.
  entity      String?   // export: comma-list of entities; import: detected entity (display)
  format      String    @default("csv")
  // Export: full spec JSON [{entity,filters,fields,advancedFilters}] from a saved
  // preset. When set it drives the run (filters/columns); else `entity` is used.
  spec        String?
  // Import source. Either a remote URL fetched FRESH on every run (https/ftp/
  // ftps/sftp/s3/Drive, credentials via saved ImportServers) …
  sourceUrl   String?
  // When sourceUrl is a FOLDER: skip files this schedule already imported
  // (tracked in importedFiles, a JSON array of filenames).
  onlyNewFiles  Boolean @default(true)
  importedFiles String?
  // … or a legacy schedule-owned R2 snapshot, re-imported as-is each run (not
  // touched by file-retention cleanup, which only clears job files).
  sourceR2Key String?
  filename    String?
  plan        String?   // import per-sheet plan JSON [{entity,include,filters,columns}]
  // Options JSON. Import: ({mode}) — update-only/no-delete/etc. Export: the
  // Advanced-section options snapshotted from the preset (zip, formatting, …).
  options     String?
  // Display timezone for the schedule (cadence math stays UTC).
  timezone    String    @default("UTC")
  // Delivery destinations JSON: { email, ftp, gdrive, gsheets, s3 } each
  // { enabled, ...config }. Secrets inside are encrypted (crypto.server.js).
  destinations String?
  // Export schedules: split the run into files of N records (null = one file).
  splitRows    Int?
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([shop])
  @@index([enabled, nextRunAt])
}

// A saved export configuration (entities + filters + column selection). Persisted
// so it survives reloads AND can be picked by a Schedule to run filtered exports.
model ExportPreset {
  id        String   @id @default(cuid())
  shop      String
  name      String
  format    String   @default("csv")
  spec      String   // JSON: [{ entity, filters, fields, advancedFilters }]
  state     String?  // JSON: the export UI's entityState, for restoring the form
  splitRows Int?     // split into files of N records (null = one file)
  options   String?  // JSON: the Advanced-section options (filename, zip, formatting, csv …)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
}

// A saved import configuration (per-sheet plan + import mode). The twin of
// ExportPreset: persisted so a plan can be reused on the Import page and picked
// by a Schedule to re-import a file with the same filters/columns/mode.
model ImportPreset {
  id        String   @id @default(cuid())
  shop      String
  name      String
  format    String   @default("csv")
  plan      String   // JSON: [{ entity, include, filters, columns }]
  options   String?  // JSON: { mode }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
}

// A stored Etsy OAuth connection for the Migrations feature (one per shop). The
// keystring is the merchant's Etsy app client id; tokens refresh via Etsy.
model EtsyConnection {
  shop         String   @id
  keystring    String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  etsyShopId   String?
  etsyShopName String?
  updatedAt    DateTime @updatedAt
}

// Short-lived state for the Etsy OAuth handshake — bridges the authorize
// redirect and the callback (holds the PKCE verifier + which shop started it).
model MigrationOAuthState {
  state        String   @id
  shop         String
  keystring    String
  codeVerifier String
  redirectUri  String
  createdAt    DateTime @default(now())
}

// A saved remote server for "Import from URL" (FTP/FTPS/SFTP credentials or
// S3 keys), matched to a typed URL by protocol + host. Backs the "+" (Add a
// new server) button on the home Import card.
model ImportServer {
  id        String   @id @default(cuid())
  shop      String
  label     String
  protocol  String   // ftp | ftps | sftp | s3
  host      String   // ftp/sftp: hostname; s3: bucket name
  port      Int?
  username  String?  // s3: access key ID
  password  String?  // s3: secret access key
  region    String?  // s3 only
  createdAt DateTime @default(now())

  @@unique([shop, protocol, host, username])
  @@index([shop])
}

// One row per schedule run (manual or cron) — backs the Scheduler's
// "Schedule history" tab. Best-effort: runner failures to log are swallowed.
model ScheduleRun {
  id           String   @id @default(cuid())
  shop         String
  scheduleId   String
  scheduleName String   @default("")
  task         String   @default("") // what ran, e.g. "Export Products as CSV"
  status       String   @default("ok") // ok | error
  rows         Int      @default(0)
  delivery     String   @default("") // short per-destination result summary
  message      String   @default("")
  runAt        DateTime @default(now())

  @@index([shop])
  @@index([scheduleId])
}

// Google OAuth tokens for Drive/Sheets schedule delivery (one per shop).
model GoogleConnection {
  shop         String    @id
  email        String    @default("")
  accessToken  String    @default("")
  refreshToken String    @default("")
  expiryDate   DateTime?
  scope        String    @default("")
  updatedAt    DateTime  @updatedAt
}
